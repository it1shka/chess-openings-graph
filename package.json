{
  "name": "chess-openings-graph",
  "version": "0.0.1",
  "description": "Chess openings database exposed in a form of a graph.",
  "homepage": "https://github.com/it1shka/chess-openings-graph#readme",
  "bugs": {
    "url": "https://github.com/it1shka/chess-openings-graph"
  },
  "license": "MIT",
  "author": "Tikhon Belousov <2tishbel@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/it1shka/chess-openings-graph.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "release": "bumpp",
    "prepublishOnly": "npm run build",
    "gen-graph": "tsx scripts/gen-graph.ts && npm run format src/*.g.ts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "bumpp": "^11.1.0",
    "chess.js": "^1.4.0",
    "csv-parser": "^3.2.1",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tsdown": "^0.22.5",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
